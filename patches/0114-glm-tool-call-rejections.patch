diff --git tensorfold/cuda/server.py tensorfold/cuda/server.py
--- tensorfold/cuda/server.py
+++ tensorfold/cuda/server.py
@@ -68,6 +68,23 @@
     return int(limit) if isinstance(limit, int) and limit > 0 else 0
 
 
+def tool_call_rejections(names: list[str], offered: int, stats: dict[str, Any]) -> dict[str, Any]:
+    """A reply's whole tool-call blocks that named a tool the request did not offer (issue #103): they stay text and
+    are never run. TF_GLM_TOOL_DIAGNOSTICS: unset (the default) logs one line, the generated names only (never an
+    argument value); ``1`` also lists them in the reply's ``tensorfold`` block as ``tool_call_rejections``
+    (``[{"reason": "unknown_tool_name", "name": ...}]``, the last streamed event's); ``0`` does neither."""
+
+    mode = os.environ.get("TF_GLM_TOOL_DIAGNOSTICS", "").strip()
+    if mode == "0":
+        return stats
+    print(f"[tensorfold] tool call rejected: unknown_tool_name {names!r} ({offered} tools offered); "
+          "kept as text", flush=True)
+    if mode != "1":
+        return stats
+    return {**stats, "tool_call_rejections": [{"reason": "unknown_tool_name", "name": n} for n in names]}
+
+
